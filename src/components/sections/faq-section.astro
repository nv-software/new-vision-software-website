---
import { FaqAccordion } from "@/components/blocks/faq-accordion";
---

<div class="space-y-8">
  <div class="text-center space-y-3">
    <p class="text-[#0098C0] font-medium text-lg">Tire suas dúvidas</p>
    <p class="font-bold text-title text-2xl">Perguntas Frequentes</p>
    <p class="text-description text-xl max-w-auto lg:max-w-[500px] mx-auto">
      Encontre aqui respostas para as dúvidas mais comuns. Se ainda precisar de
      ajuda, fale com a gente!
    </p>
  </div>
  <div class="max-w-auto lg:max-w-7xl mx-auto">
    <FaqAccordion client:visible />
  </div>
</div>
