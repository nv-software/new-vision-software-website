---
import { ContactForm } from "@/components/blocks/contact-form";
import { Phone, Clock, AtSign } from "@lucide/astro";
---

<div class="stack">
  <div class="lg:grid grid-cols-2 hidden grid-rows-1">
    <div></div>
    <div class="bg-[#F7F6FA]"></div>
  </div>
  <div
    class="mx-auto container space-y-4 p-4 grid grid-rows-[1fr] grid-cols-1 lg:grid-rows-1 lg:grid-cols-2"
  >
    <div
      class="text-description py-0 lg:py-20 grid grid-cols-2 lg:grid-cols-1 grid-rows-[1fr] gap-4 lg:gap-12"
    >
      <h3
        class="!text-title max-w-auto lg:max-w-[420px] text-2xl lg:text-4xl font-medium col-span-2 lg:col-span-1"
      >
        Pronto para transformar sua ideia em realidade?
      </h3>
      <div class="space-y-3">
        <div class="flex items-center gap-2 font-medium !text-title">
          <Phone size="16" />
          <p>Fale com a gente</p>
        </div>
        <p>+55 (99) 99999-9999</p>
        <p>+55 (99) 99999-9999</p>
      </div>
      <div class="space-y-3">
        <div class="flex items-center gap-2 font-medium !text-title">
          <AtSign size="16" />
          <p>Mande um e-mail</p>
        </div>
        <p>mycael.dias@newvision.com.br</p>
        <p>paulo.olivetti@newvision.com.br</p>
      </div>
      <div class="space-y-3">
        <div class="flex items-center gap-2 font-medium !text-title">
          <Clock size="16" />
          <p>Horário de atendimento</p>
        </div>
        <p>Segunda - Sexta</p>
        <p>9AM - 5PM</p>
      </div>
    </div>
    <div class="my-auto ml-0 lg:ml-12">
      <ContactForm client:visible />
    </div>
  </div>
</div>
