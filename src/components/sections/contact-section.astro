---
import { ContactForm } from "@/components/blocks/contact-form";
import { Mail, Phone } from "@lucide/astro";
---

<div class="stack">
  <div class="grid grid-cols-2 grid-rows-1">
    <div class="bg-black/5"></div>
  </div>
  <div class="px-6 container py-12 grid grid-cols-2 grid-rows-1 gap-8">
    <div class="space-y-2 my-auto">
      <p class="text-2xl font-medium text-title">Pronto para começar?</p>
      <p class="text-foreground">
        Tire suas dúvidas, compartilhe suas ideias e vamos transformar em
        resultados reais.
      </p>
      <div class="space-y-1 text-muted-foregound">
        <div class="flex gap-2 items-center">
          <Mail size="16" />
          <a href="mailto:contato@newvision.com.br" target="_blank">
            contato@newvision.com.br
          </a>
        </div>
        <div class="flex gap-2 items-center">
          <Phone size="16" />
          <a href="tel:9999999999999" target="_blank">+99 (99) 99999-9999</a>
        </div>
      </div>
    </div>
    <ContactForm client:idle />
  </div>
</div>
