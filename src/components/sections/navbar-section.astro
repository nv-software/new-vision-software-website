---
import { Image } from "astro:assets";
import logo from "@/assets/images/logo.svg";
import { Button } from "@/components/ui/button";
---

<section
  class="h-[80px] relative flex items-center justify-center w-full container px-4 z-[100]"
>
  <Image
    loading="eager"
    class="absolute left-0 w-[180px] px-4"
    src={logo}
    alt="New Vision Software"
    draggable="false"
  />
  <nav class="text-white hidden lg:flex font-medium gap-4 mx-auto">
    <a href="#solutions">Soluções</a>
    <a href="#portfolio">Portfólio</a>
    <a href="#faq">FAQ</a>
  </nav>
  <div class="absolute right-0 px-4">
    <Button>Explore nossas soluções</Button>
  </div>
</section>
