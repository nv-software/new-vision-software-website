---
import { cn } from "@/lib/utils";
import { Workflow } from "@lucide/astro";
import { Integration } from "../blocks/integration";
import { GridPattern } from "../magicui/grid-pattern";
---

<div class="container py-8 space-y-8">
  <div class="text-center space-y-2">
    <h3
      class="antialiased text-5xl text-center mx-auto font-medium text-foreground"
    >
      Tecnologia sólida, resultados reais
    </h3>
    <p class="text-xl text-muted-foreground">
      Seu projeto em boas mãos: tecnologia feita para funcionar, evoluir e
      durar.
    </p>
  </div>
  <div class="grid grid-cols-3 grid-rows-1 gap-4"></div>
</div>
