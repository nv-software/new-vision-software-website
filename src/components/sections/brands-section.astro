---
import { Image } from "astro:assets";
import havaianasLogo from "@/assets/brands/havaianas.svg";
import heringLogo from "@/assets/brands/hering.svg";
import mizunoLogo from "@/assets/brands/mizuno.svg";
import osklenLogo from "@/assets/brands/osklen.svg";
import riachueloLogo from "@/assets/brands/riachuelo.svg";
---

<div class="container py-8 px-6 space-y-6">
  <p class="text-center text-slate-900">Nomes que confiam na nossa entrega</p>
  <div class="flex justify-evenly items-center gap-12">
    <Image
      loading="eager"
      draggable="false"
      class="max-h-[30px]"
      alt="Riachuelo"
      src={riachueloLogo}
    />
    <Image
      draggable="false"
      class="max-h-[30px]"
      alt="Havaianas"
      src={havaianasLogo}
      loading="eager"
    />
    <Image
      draggable="false"
      class="max-h-[30px]"
      alt="Mizuno"
      src={mizunoLogo}
      loading="eager"
    />
    <Image
      draggable="false"
      class="max-h-[30px]"
      alt="Hering"
      src={heringLogo}
      loading="eager"
    />
    <Image
      draggable="false"
      class="max-h-[30px]"
      alt="Osklen"
      src={osklenLogo}
      loading="eager"
    />
  </div>
</div>
